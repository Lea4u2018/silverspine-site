# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Leameso OLD backups — stay on disk, not Git “new file” red
/OLD *
OLD *

# local tooling / scratch
.cursor/
.venv-audio/
.tmp-amazon-video/

# PyCharm chat DBs rewrite every second and paint the tree red
.idea/firebender/
.idea/workspace.xml

# Next.js agent stubs (recreated locally)
AGENTS.md
CLAUDE.md

# local drafts / not site source
printables/EMAIL_ARCHIVE/
printables/SEND_*
SILVERSPINE_FULL_WEBSITE_CODING.html
SILVERSPINE_THUMBDRIVE_READ_ME.txt
