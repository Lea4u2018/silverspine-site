// pages/books.js
import Head from "next/head";
import Link from "next/link";
import { useEffect, useRef, useState } from "react";
import {
  FaFacebook,
  FaTwitter,
  FaInstagram,
  FaYoutube,
  FaTiktok,
  FaVolumeMute,
  FaVolumeUp,
} from "react-icons/fa";

export default function Books() {
  const audioRefs = useRef({});
  const [audioEnabled, setAudioEnabled] = useState(false);
  const [showHint, setShowHint] = useState(false);
  const [logoSrc, setLogoSrc] = useState(null);
  const [useTextLogo, setUseTextLogo] = useState(false);

  // ---- LOGO PREFLIGHT (tries two files; falls back to text to avoid broken image) ----
  useEffect(() => {
    if (typeof window === "undefined") return;
    let cancelled = false;
    const CANDIDATES = [
      "/SilverSpine_FB_Profile_1024.png",
      "/Silver_Spine_Studio_Logo_2025_10_11.png",
    ];
    const tryLoad = (idx = 0) => {
      if (idx >= CANDIDATES.length) {
        if (!cancelled) setUseTextLogo(true);
        return;
      }
      const img = new Image();
      img.onload = () => { if (!cancelled) setLogoSrc(CANDIDATES[idx]); };
      img.onerror = () => tryLoad(idx + 1);
      img.src = CANDIDATES[idx] + `?v=${Date.now()}`;
    };
    tryLoad();
    return () => { cancelled = true; };
  }, []);

  // Enable whispers after first user gesture (browser policy)
  useEffect(() => {
    if (typeof window === "undefined") return;
    const enableAudio = () => setAudioEnabled(true);
    window.addEventListener("pointerdown", enableAudio, { once: true });
    return () => window.removeEventListener("pointerdown", enableAudio);
  }, []);

  const playWhisper = (id) => {
    const audio = audioRefs.current[id];
    if (!audio) return;
    if (!audioEnabled) {
      setShowHint(true);
      setTimeout(() => setShowHint(false), 1800);
      return;
    }
    try {
      audio.pause();
      audio.currentTime = 0;
      audio.playbackRate = id === 1 ? 1.02 : 0.92;
      audio.volume = 0.18;
      audio.play().catch(() => {});
    } catch {}
  };

  const stopWhisper = (id) => {
    const audio = audioRefs.current[id];
    if (!audio) return;
    if (id === 1) {
      const fade = setInterval(() => {
        if (audio.volume > 0.05) {
          audio.volume = Math.max(0, audio.volume - 0.07);
        } else {
          clearInterval(fade);
          audio.pause();
          audio.volume = 0.18;
        }
      }, 40);
    } else {
      audio.pause();
      audio.currentTime = 0;
    }
  };

  const GOLD = "#a77a23";

  const books = [
    { id: 1, title: "THE BEAUTIFUL BEAST", tagline: "The first strike in the storm.", img: "/covers/1-the-beautiful-beast-blank-cover.jpg", whisper: "/audio/beast_whisper_01.mp3", color: "#F5E6C8", ribbon: "COMING SOON" },
    { id: 2, title: "SHADOWS OF A GHOST", tagline: "A shadow doesn’t vanish — it just learns to wait.", img: "/covers/2-shadows-of-a-ghost-arthur-blank-cover.jpg", whisper: "/audio/ghost_whisper_01.mp3", color: "#E5C877", ribbon: "IN THE WORKS" },
    { id: 3, title: "THE GATHERING STORM", tagline: "The sting of lightning before the clap of thunder.", img: "/covers/3-the-gathering-storm-bee-blank-cover.jpg", whisper: "/audio/storm_whisper_01.mp3", color: "#D4A24B", ribbon: "SIMMERING" },
    { id: 4, title: "FRAGILE UNBROKEN", tagline: "What doesn’t shatter learns how to cut.", img: "/covers/4-fragile-unbroken-elliot-blank-cover.jpg", whisper: "/audio/fragile_whisper_01.mp3", color: "#C57A2A", ribbon: "WHEELS TURNING" },
    { id: 5, title: "THE MACHINE", tagline: "When prayer is your only hope — don’t skip it!", img: "/covers/5-the-machine-lancaster-blank-cover.jpg", whisper: "/audio/machine_whisper_01.mp3", color: "#A0522D", ribbon: "BASKING IN TIME" },
    { id: 6, title: "SCARRED TRUTH", tagline: "When no one’s secrets are safe — and the truth is unmerciful.", img: "/covers/6-scarred-truth-saxe-blank-cover.jpg", whisper: "/audio/scarred_whisper_01.mp3", color: "#993300", ribbon: "HOLDING TIGHT" },
    { id: 7, title: "SCORCHED EARTH", tagline: "Before the ashes settle — no one is safe.", img: "/covers/7-scorched-earth-francis-blank-cover.jpg", whisper: "/audio/scorched_whisper_01.mp3", color: "#8B0000", ribbon: "THE BEST TO COME" },
  ];

  // --- Inline, SSR-safe mic/speaker toggle (no external component) ---
  const [siteAudioMuted, setSiteAudioMuted] = useState(true);
  useEffect(() => {
    if (typeof document === "undefined") return;
    let el = document.getElementById("site-audio");
    if (!el) {
      el = document.createElement("audio");
      el.id = "site-audio";
      el.src = "/thunder_rumble.mp3"; // adjust or remove if not needed here
      el.loop = true;
      el.preload = "auto";
      document.body.appendChild(el);
    }
    el.muted = true;
  }, []);
  const toggleSiteAudio = async () => {
    if (typeof document === "undefined") return;
    const a = document.getElementById("site-audio");
    if (!a) return;
    try {
      if (a.paused) {
        a.muted = false;
        a.volume = 0.25;
        await a.play();
        setSiteAudioMuted(false);
      } else {
        a.pause();
        setSiteAudioMuted(true);
      }
    } catch {}
  };

  return (
    <div className="bg-black text-gray-100 min-h-screen flex flex-col relative overflow-hidden">
      <Head>
        <title>Books | Silver Spine Studio™</title>
        <meta name="description" content="The Silver Spine Studio™ Series — The seven-fold chronicle. Stories forged in storm and consequence." />
        {/* Font for headings */}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossOrigin="anonymous" />
        <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
        <style>{`
          /* Nebula letterbox + cinematic black ribbons */
          .nebula { position: relative; width: 100%;
            background-image: url('/FB_Cover_Nebula_DarkerShadows_fix_1640x624.jpg');
            background-size: cover; background-position: center;
            filter: saturate(1.15) contrast(1.1);
          }
          .nebula-top { height: 260px; }     /* closer to heading */
          .nebula-bottom { height: 220px; }  /* moved up toward books */

          /* Keep more of the nebula visible (stronger fade) */
          .mask-top {
            -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 84%, rgba(0,0,0,0));
                    mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 84%, rgba(0,0,0,0));
          }
          .mask-bottom {
            -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 86%, rgba(0,0,0,0));
                    mask-image: linear-gradient(to top, rgba(0,0,0,1) 86%, rgba(0,0,0,0));
          }

          /* Thin black bars at nebula edges */
          .letterbox-bar { position: absolute; left: 0; right: 0; height: 14px; background: rgba(0,0,0,0.95); }
          .letterbox-bar.top-edge { bottom: 0; }
          .letterbox-bar.bottom-edge { top: 0; }

          @media (max-width: 1280px) {
            .nebula-top { height: 210px; }
            .nebula-bottom { height: 180px; }
            .letterbox-bar { height: 12px; }
          }
          @media (max-width: 768px) {
            .nebula-top { height: 150px; }
            .nebula-bottom { height: 140px; }
            .letterbox-bar { height: 10px; }
          }

          /* grid + cards */
          .book-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 2rem; justify-items: center; align-items: start;
            max-width: 88%;
            margin: 0 auto 2.75rem;  /* keeps bottom nebula close */
            padding: 2rem 1rem 4rem; /* room for hover taglines */
          }
          @media (max-width: 1600px) { .book-grid { grid-template-columns: repeat(4, 1fr); } }
          @media (max-width: 1024px) { .book-grid { grid-template-columns: repeat(3, 1fr); } }
          @media (max-width: 768px)  { .book-grid { grid-template-columns: repeat(2, 1fr); } }
          @media (max-width: 480px)  { .book-grid { grid-template-columns: 1fr; } }

          .book-card {
            position: relative; border-radius: 1rem; overflow: hidden;
            aspect-ratio: 2 / 3; width: 100%; max-width: 300px;
            background: rgba(12,12,12,0.55); border: 1px solid #7e7e70;
            transition: transform .25s ease, box-shadow .25s ease;
          }
          .book-card:hover { transform: translateY(-3px) scale(1.015); box-shadow: 0 0 45px var(--glow), 0 0 75px var(--glow); }
          .book-card img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.15) saturate(1.15) brightness(1.05); pointer-events: none; }

          .ribbon { position:absolute; top:50%; left:50%; width:250%; height:58%; transform:translate(-50%,-50%) rotate(-45deg); background:#000; display:flex; align-items:center; justify-content:center; z-index:6; }
          .ribbon-text { color:#fff; font:700 1rem/1 'Libre Baskerville', Georgia, serif; letter-spacing:.22em; text-transform:uppercase; opacity:.95; }

          .book-title { position:absolute; top:20px; left:50%; transform:translateX(-50%); width:92%; text-align:center; font:700 2rem/1.16 'Libre Baskerville', Georgia, serif; color:var(--glow); text-shadow:0 0 18px rgba(0,0,0,.6); z-index:4; }
          .author-name { position:absolute; bottom:20px; left:50%; transform:translateX(-50%); width:92%; text-align:center; font:700 1.2rem/1.2 'Libre Baskerville', Georgia, serif; color:var(--glow); letter-spacing:.18em; z-index:4; }
          .tagline { margin-top:.8rem; text-align:center; color:var(--glow); font-style:italic; font-size:1rem; opacity:0; transition:opacity .6s ease-in-out; }
          .book-card:hover + .tagline { opacity:.9; }

          .heading {
            text-align:center; color:${GOLD}; font-size:3.4rem; font-weight:800; line-height:1.2;
            margin-top: 6.5rem; letter-spacing:.02em; text-shadow:0 2px 12px rgba(0,0,0,.6);
          }
          @media (max-width: 1280px) { .heading { margin-top: 5.5rem; } }
          @media (max-width: 768px)  { .heading { margin-top: 4rem; font-size: 2.4rem; } }

          .subheading { text-align:center; color:#f3e2b8; font-size:1.05rem; font-style:italic; margin:1rem 0 2rem; }

          /* Mic button placement (lower so it’s never covered) */
          .audio-toggle-btn { position: fixed; right: 18px; top: 148px; z-index: 50; }
          @media (max-width: 768px) { .audio-toggle-btn { top: 118px; } }
        `}</style>
      </Head>

      {/* HEADER — EXACT SAME STYLE AS HOME */}
      <header className="relative z-10 bg-gradient-to-b from-gray-900 to-gray-800/90 shadow-[0_8px_24px_rgba(0,0,0,0.35)] border-b border-[#a77a23]/30">
        <div className="max-w-6xl mx-auto flex justify-between items-center px-4 md:px-6 py-3 md:py-4">
          <Link href="/" className="flex items-center gap-3 md:gap-4 group" aria-label="Silver Spine Studio — Home">
            {logoSrc && !useTextLogo ? (
              <img
                src={logoSrc}
                alt="Silver Spine Studio logo"
                className="h-[72px] md:h-[88px] lg:h-[100px] w-auto select-none shrink-0 drop-shadow-[0_6px_18px_rgba(167,122,35,0.25)]"
                draggable="false"
              />
            ) : (
              <span className="text-2xl md:text-3xl font-extrabold text-[#a77a23] select-none">
                Silver Spine Studio<span className="align-super text-base md:text-lg">™</span>
              </span>
            )}
            <span className="hidden sm:inline text-lg md:text-2xl font-semibold tracking-wide text-[#a77a23]">
              Silver Spine Studio<span className="align-super text-sm md:text-base">™</span>
            </span>
          </Link>

          <nav className="flex items-center gap-5 md:gap-6 text-sm md:text-base">
            <Link href="/" className="text-gray-200 hover:text-[#a77a23]">Home</Link>
            <Link href="/books" className="text-red-700 font-semibold" aria-current="page">Books</Link>
            <Link href="/about" className="text-gray-200 hover:text-[#a77a23]">About</Link>
            <Link href="/contact" className="text-gray-200 hover:text-[#a77a23]">Contact</Link>
            <Link href="/blog" className="text-gray-200 hover:text-[#a77a23]">Blog</Link>
            <Link href="/reviews" className="text-gray-200 hover:text-[#a77a23]">Reviews</Link>
          </nav>
        </div>
      </header>

      {/* TOP NEBULA — closer, with thin black ribbon on its bottom edge */}
      <div className="nebula nebula-top mask-top">
        <div className="letterbox-bar top-edge" />
      </div>

      {/* MAIN CONTENT */}
      <main className="flex-1 relative z-10 pb-12">
        <h1 className="heading">
          The Silver Spine Studio<span className="align-super text-base">™</span> Series: The seven-fold chronicle.
        </h1>
        <h2 className="subheading">
          Hover a book to feel the charge. Tap once anywhere to enable whispers.
        </h2>

        <section className="book-grid">
          {books.map((b) => (
            <div key={b.id} style={{ textAlign: "center" }}>
              <div
                className="book-card"
                style={{ "--glow": b.color }}
                onMouseEnter={() => playWhisper(b.id)}
                onMouseLeave={() => stopWhisper(b.id)}
              >
                <img src={b.img} alt={b.title} />
                {b.id !== 1 && (
                  <div className="ribbon">
                    <span className="ribbon-text">{b.ribbon}</span>
                  </div>
                )}
                <p className="book-title">{b.title}</p>
                <p className="author-name" style={{ color: GOLD }}>LEAMESO JAMES</p>
                <audio ref={(el) => (audioRefs.current[b.id] = el)} src={b.whisper} preload="auto" />
              </div>
              <p className="tagline" style={{ "--glow": GOLD }}>{b.tagline}</p>
            </div>
          ))}
        </section>
      </main>

      {/* BOTTOM NEBULA — moved up near books, with thin black ribbon on its top edge */}
      <div className="nebula nebula-bottom mask-bottom">
        <div className="letterbox-bar bottom-edge" />
      </div>

      {/* FOOTER — same tone as Home (gold hover) */}
      <footer className="w-full bg-gray-950/90 backdrop-blur-md border-t border-gray-800 text-gray-300 text-center py-8">
        <p className="mb-2 text-sm">
          © {new Date().getFullYear()} Silver Spine Studio<span className="align-super text-xs">™</span>. All rights reserved.
        </p>
        <div className="flex justify-center space-x-6 text-xl">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" className="hover:text-[#a77a23] transition-colors"><FaFacebook /></a>
          <a href="https://twitter.com"  target="_blank" rel="noopener noreferrer" className="hover:text-[#a77a23] transition-colors"><FaTwitter /></a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" className="hover:text-[#a77a23] transition-colors"><FaInstagram /></a>
          <a href="https://youtube.com"  target="_blank" rel="noopener noreferrer" className="hover:text-[#a77a23] transition-colors"><FaYoutube /></a>
          <a href="https://tiktok.com"    target="_blank" rel="noopener noreferrer" className="hover:text-[#a77a23] transition-colors"><FaTiktok /></a>
        </div>
      </footer>

      {/* Mic / Speaker button — LOWER so it’s not covered */}
      <button
        type="button"
        aria-label={siteAudioMuted ? "Play site audio" : "Pause site audio"}
        onClick={toggleSiteAudio}
        className="audio-toggle-btn rounded-full bg-black/80 border border-white/20 shadow-lg px-3 py-3 hover:bg-black/90 transition-colors text-[#a77a23]"
      >
        {siteAudioMuted ? <FaVolumeMute size={18} /> : <FaVolumeUp size={18} />}
      </button>

      {showHint && (
        <div
          className="fixed bottom-4 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full text-sm"
          style={{ background:"rgba(20,20,20,0.85)", color:GOLD, border:"1px solid rgba(167,122,35,0.35)" }}
        >
          Tap once to enable audio.
        </div>
      )}
    </div>
  );
}
